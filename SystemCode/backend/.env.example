# Environment variable template: copy this file to .env in the same folder
# (SystemCode/backend/.env) and fill in real values.
# .env is never committed; this file IS committed, so keep placeholders only - never real keys.
# Lines starting with # are inactive; the defaults in app/core/config.py apply.

# ===== Required: PostgreSQL (local docker-compose database defaults below) =====
# DATABASE_URL=postgresql+psycopg://careerpilot:careerpilot@127.0.0.1:5433/careerpilot

# ===== Required: LLM (resume parsing, JD extraction, resume rewriting) - choose ONE option =====
# Option 1: Google Gemini free tier. Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Option 2: any OpenAI-compatible provider. All three are required; when set, they take precedence over Gemini
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# ===== Optional: mock interview English answer transcription (Cloudflare Workers AI - Whisper) =====
# Without these, you can still draw questions and record answers; only transcription is unavailable
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_STT_MODEL=@cf/openai/whisper-large-v3-turbo

# ===== Optional: responsibility semantic matching (local model, downloaded and cached on first use) =====
# RESPONSIBILITY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RESPONSIBILITY_SIMILARITY_FLOOR=0.35
# RESPONSIBILITY_SIMILARITY_FULL=0.75